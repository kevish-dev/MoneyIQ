// Copy this file to Secrets.xcconfig (same folder) and fill in your own
// OAuth client IDs. Secrets.xcconfig is gitignored — never commit real
// credentials.
//
// Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
// (type: iOS)
MIQ_GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
MIQ_GOOGLE_REDIRECT_URI = moneyiq://oauth/google

// GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
// Authorization callback URL must exactly match MIQ_GITHUB_REDIRECT_URI below.
MIQ_GITHUB_CLIENT_ID = your-github-client-id
MIQ_GITHUB_REDIRECT_URI = moneyiq://oauth/github

// Supabase (cloud storage + sign-in): Project Settings -> API.
// Use the *publishable* key only — never the secret key. Note the `$()` in the
// URL: it stops `//` from being read as an xcconfig comment.
MIQ_SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
MIQ_SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxx
